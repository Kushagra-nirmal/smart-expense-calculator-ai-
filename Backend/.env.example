NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/expenseTracker
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost
PUBLIC_APP_URL=http://localhost:5173
# Optional password-reset delivery (backend only; never put these in Frontend)
RESEND_API_KEY=
RESET_FROM_EMAIL=ExpenseSense <noreply@example.com>
# Optional grounded language assistant; key remains server-side
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
